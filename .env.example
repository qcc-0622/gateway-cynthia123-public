# ===========================================================
# Chat Gateway 环境变量模板
# 复制为 .env 后填入真实值（不要把 .env 提交到 git）
# ===========================================================

# 客户端连接网关用的 API key（RikkaHub 之类的客户端填这个）
GATEWAY_API_KEY=请生成一个长随机字符串

# 管理后台登录密码
ADMIN_PASSWORD=请设置一个强密码

# 会话 cookie 签名密钥（随机 32 位以上）
ADMIN_SECRET_KEY=请生成一个 64 位随机字符串

# 数据库与配置路径（默认即可）
DB_PATH=data/gateway.db
UPSTREAMS_FILE=data/upstreams.json

# 时区（影响日志、归档时间显示）
TIMEZONE=Asia/Shanghai

# 监听地址（只监听本地，由 Nginx 反代）
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8899

# 上游请求超时（秒）
UPSTREAM_TIMEOUT=120

# Keep-alive 配置：活跃时段内无对话超过 N 分钟时静默刷新 prompt cache
KEEPALIVE_ENABLED=true
KEEPALIVE_START_HOUR=8
KEEPALIVE_END_HOUR=23
KEEPALIVE_INTERVAL=55

# 可选：代理（如果服务器要走代理访问上游）
# 注意：httpx/requests 默认信任这些变量，配了之后所有外呼都走代理！
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# 强烈建议同时配 NO_PROXY，让 AI 上游/推送直连，代理只兜底名单外的域名
# （2026-08-28 事故：代理节点全灭导致网关连不上任何上游，客户端报 StreamReset，详见维护手册 Issue #39）
# NO_PROXY=api.example.com,api.deepseek.com,api.siliconflow.cn,ntfy.sh,www.pushplus.plus,127.0.0.1,localhost
